cabal-version: 3.4
name:          tree-sitter-python
version:       1.0.0
synopsis:      Tree-sitter grammar/parser for Python, preprocessed for Cubix
description:
  The tree-sitter-python@0.23.6 grammar with aliases and supertypes stripped
  (see README.md), compiled for use with the hs-tree-sitter package.
category:      Language
license:       MIT
license-file:  LICENSE
build-type:    Simple
bug-reports:   https://github.com/cubix-framework/cubix/issues
extra-source-files:
  README.md
  vendor/grammar.json
  cbits/src/grammar.json
  cbits/src/node-types.json
  cbits/src/parser.c
  cbits/src/scanner.c
  cbits/src/tree_sitter/tree-sitter-python.h
  cbits/src/tree_sitter/alloc.h
  cbits/src/tree_sitter/array.h
  cbits/src/tree_sitter/parser.h

common language
  default-language: GHC2021

library
  import: language
  exposed-modules:
    TreeSitter.Python
  build-depends:
      base >= 4.12 && < 5
    , base-compat-constptr  >=0.1  && <0.2
  include-dirs:
    cbits/src
  includes:
    tree_sitter/tree-sitter-python.h
  c-sources:
    cbits/src/parser.c
    cbits/src/scanner.c
