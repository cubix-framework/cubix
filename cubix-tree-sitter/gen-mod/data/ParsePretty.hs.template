parse :: FilePath -> IO (ConstPtr lang) -> IO (Maybe (${grammarName}TermAnn (Maybe SourceSpan) (RootSort M.${sigType})))
parse path getLang = do
  mEnv <- newTreeSitterEnv path getLang
  case mEnv of
    Nothing  -> pure Nothing
    Just env -> runReaderT parse' env <&> caseE @_ @(RootSort M.${sigType})
