cabal-version: 3.4
name:          cubix-python-ts
version:       1.0.0
synopsis:      Cubix support for Python, generated from its tree-sitter grammar
description:   Cubix support for Python, generated from its tree-sitter grammar
category:      Language
license:       BSD-3-Clause
license-file:  LICENSE
build-type:    Simple
bug-reports:   https://github.com/cubix-framework/cubix/issues

tested-with:
  GHC == 9.8.4

common language
  default-language: GHC2021
  default-extensions:
    ApplicativeDo
    DataKinds
    DefaultSignatures
    DerivingStrategies
    FunctionalDependencies
    GADTs
    LambdaCase
    MultiWayIf
    NamedFieldPuns
    OverloadedStrings
    PatternSynonyms
    QuasiQuotes
    TypeFamilies
    TypeFamilyDependencies
    TypeOperators
    ViewPatterns

common ghc-options
  ghc-options:
    -W
    -fno-warn-unused-foralls
    -freduction-depth=1000

common dependencies
  build-depends:
    , base >= 4.19.2.0
    , base-compat-constptr
    , bytestring ^>= 0.12
    , containers >= 0.6.8
    , compstrat ^>= 0.1.0.3
    , cubix >= 0.7.0.15
    , cubix-compdata >= 1.0.2
    , cubix-tree-sitter
    , hs-tree-sitter ^>= 13
    , megaparsec ^>= 9.6
    , parser-combinators ^>= 1.3
    , pretty-simple
    , template-haskell >= 2.21.0.0
    , text >= 2.1.2
    , transformers ^>= 0.6
    , tree-sitter-python

library
  import: language
  import: ghc-options
  import: dependencies
  hs-source-dirs: src
  ghc-options:
    -O0
  exposed-modules:
    Cubix.Language.PythonTS.Modularized
    Cubix.Language.PythonTS.RawParse

executable python-ts-parse
  import: language
  import: ghc-options
  import: dependencies
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -O0
  build-depends:
    , cubix-python-ts
    , cubix-tree-sitter:testing

test-suite parse-samples
  import: language
  import: ghc-options
  import: dependencies
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -O0
  build-depends:
    , cubix-python-ts
    , cubix-tree-sitter:testing
    , directory >= 1.3
    , filepath >= 1.4
